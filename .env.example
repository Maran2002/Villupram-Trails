# Copy to .env.local for local development. Never commit real credentials.
MONGODB_URI=mongodb://127.0.0.1:27017/villupuram_db
# Generate unique values locally; never deploy the example text as a secret.
JWT_SECRET=
ADMIN_ACCESS_TOKEN=
NEXT_PUBLIC_SITE_URL=
GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_API_BASE_URL=
NEXT_PUBLIC_AUTHOR_LINK=
API_TIMEOUT=10000

# Brevo transactional email (server-side only; never expose the API key publicly)
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=Villupuram Trails
# Optional dedicated key for OTP HMACs. If unset, JWT_SECRET is used.
EMAIL_OTP_SECRET=

# Only for one-time initial administrator bootstrap when the database has no admins.
INITIAL_ADMIN_USERNAME=
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=
# After bootstrap, set this to the printed account ID and restart the application.
SUPERADMIN_ID=
